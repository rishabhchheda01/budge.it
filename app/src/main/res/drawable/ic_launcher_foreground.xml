<?xml version="1.0" encoding="utf-8"?>
<!-- A "b." drawn with simple lines. The canvas is 108x108; keep the shapes inside
     roughly 21-87 so the launcher can crop the icon into a circle/squircle safely. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The "b": a vertical stem plus a round bowl. Change strokeColor to recolor. -->
    <path
        android:pathData="M38,32 L38,76 M38,64 A12,12 0 1 1 62,64 A12,12 0 1 1 38,64"
        android:strokeColor="#FAFAFA"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The dot after the "b". Change fillColor to recolor. -->
    <path
        android:pathData="M65,75.5 A3.5,3.5 0 1 1 72,75.5 A3.5,3.5 0 1 1 65,75.5 Z"
        android:fillColor="#FAFAFA" />
</vector>
