<?xml version="1.0" encoding="utf-8"?>
<!-- Shown briefly while the widget loads. Just the sand background, no spinner, so it blends
     into the real widget. The color and corners live in drawable/widget_loading_background.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_loading_background" />
